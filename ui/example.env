# Optional API endpoint for the UI development server or UI build.
# Use an absolute URL that the browser can reach.
# If unset, the UI uses the current origin followed by /api.
# For a non-root API path, include that path in the URL.
# This setting is embedded in the UI build; changing the container
# environment after the build does not change it.
REACT_APP_API_ENDPOINT=http://localhost:4001/api
